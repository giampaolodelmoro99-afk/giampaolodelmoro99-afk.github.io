{
  "name": "portfolio-win95",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/postbuild.mjs && npm run build:storybook",
    "preview": "node scripts/preview.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "oxlint --type-aware && stylelint --allow-empty-input \"src/**/*.css\" \".storybook/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:prerender": "vitest run --project prerender",
    "test:prerender:site": "vitest run --project prerender tests/prerender/html.test.ts",
    "test:e2e": "docker run --rm -v \"$PWD\":/work -w /work -u \"$(id -u):$(id -g)\" -e HOME=/tmp -e CI=1 mcr.microsoft.com/playwright:v1.64.0-noble sh -c \"npx playwright test --grep-invert @performance && npx playwright test --project=performance --workers=1\"",
    "test:e2e:chromium": "docker run --rm -v \"$PWD\":/work -w /work -u \"$(id -u):$(id -g)\" -e HOME=/tmp -e CI=1 mcr.microsoft.com/playwright:v1.64.0-noble npx playwright test --project=chromium-1440 --project=chromium-375 --project=touch-pixel-7",
    "test:e2e:update-snapshots": "docker run --rm -v \"$PWD\":/work -w /work -u \"$(id -u):$(id -g)\" -e HOME=/tmp -e CI=1 mcr.microsoft.com/playwright:v1.64.0-noble npx playwright test --grep @visual --update-snapshots",
    "test:e2e:host": "playwright test --grep-invert @visual",
    "size": "size-limit",
    "size:components": "SIZE_COMPONENTS=1 size-limit",
    "lhci:mobile": "lhci autorun --config=lighthouserc.mobile.json",
    "lhci:desktop": "lhci autorun --config=lighthouserc.desktop.json",
    "lhci:mobile:strict": "lhci autorun --config=lighthouserc.mobile.strict.json",
    "lhci:desktop:strict": "lhci autorun --config=lighthouserc.desktop.strict.json",
    "fonts": "node scripts/fonts.mjs",
    "icons": "node scripts/icons.mjs",
    "build:site": "react-router build && node scripts/postbuild.mjs",
    "build:storybook": "storybook build -o build/client/storybook --quiet && node scripts/postbuild-storybook.mjs",
    "storybook": "storybook dev -p 6006",
    "analyze": "ANALYZE=1 react-router build && node scripts/postbuild.mjs"
  },
  "dependencies": {
    "@react-router/node": "^8.5.1",
    "isbot": "^5.2.2",
    "react": "^19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@react-aria/optimize-locales-plugin": "^2.1.0",
    "@react-router/dev": "^8.5.1",
    "@size-limit/esbuild": "^14.2.0",
    "@size-limit/file": "^14.2.0",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/fontkit": "^2.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/subset-font": "^2.3.0",
    "@vitest/coverage-v8": "^5.0.4",
    "axe-core": "^4.14.0",
    "fontkit": "^2.0.4",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "react-aria": "3.53.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "size-limit": "^14.2.0",
    "storybook": "^10.6.2",
    "stylelint": "^17.16.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "subset-font": "^2.9.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vitest-axe": "^0.1.0"
  }
}
