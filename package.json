{
  "name": "portfolio-win95",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/postbuild.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "oxlint --type-aware && stylelint --allow-empty-input \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:prerender": "vitest run --project prerender",
    "test:e2e": "docker run --rm -v \"$PWD\":/work -w /work -u \"$(id -u):$(id -g)\" -e HOME=/tmp -e CI=1 mcr.microsoft.com/playwright:v1.64.0-noble npx playwright test",
    "test:e2e:update-snapshots": "docker run --rm -v \"$PWD\":/work -w /work -u \"$(id -u):$(id -g)\" -e HOME=/tmp -e CI=1 mcr.microsoft.com/playwright:v1.64.0-noble npx playwright test --grep @visual --update-snapshots",
    "test:e2e:host": "playwright test --grep-invert @visual",
    "size": "size-limit",
    "lhci:mobile": "lhci autorun --config=lighthouserc.mobile.json",
    "lhci:desktop": "lhci autorun --config=lighthouserc.desktop.json"
  },
  "dependencies": {
    "@react-router/node": "^8.4.0",
    "isbot": "^5.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@react-router/dev": "^8.4.0",
    "@size-limit/file": "^14.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.4",
    "axe-core": "^4.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "size-limit": "^14.2.0",
    "stylelint": "^17.16.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vitest-axe": "^0.1.0"
  }
}
