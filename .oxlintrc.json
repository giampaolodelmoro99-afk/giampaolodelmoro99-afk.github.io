{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "jsx-a11y", "typescript", "import", "unicorn", "oxc", "vitest"],
  "env": { "browser": true, "node": true, "es2024": true },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "ignorePatterns": [
    "build/**",
    "coverage/**",
    ".react-router/**",
    "playwright-report/**",
    "test-results/**",
    "storybook-static/**"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/no-danger": "error",
    "react/react-in-jsx-scope": "off",
    "react/only-export-components": [
      "error",
      {
        "allowConstantExport": true,
        "allowExportNames": [
          "meta",
          "links",
          "handle",
          "Layout",
          "ErrorBoundary",
          "HydrateFallback"
        ]
      }
    ],
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/control-has-associated-label": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/tabindex-no-positive": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/heading-has-content": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-floating-promises": "error",
    "import/no-cycle": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-commented-out-tests": "error",
    "vitest/no-conditional-tests": "error",
    "vitest/expect-expect": [
      "error",
      { "assertFunctionNames": ["expect", "expect.*", "expectNoAxeViolations"] }
    ],
    "vitest/warn-todo": "error",
    "no-restricted-globals": [
      "error",
      { "name": "location", "message": "Naviga solo con React Router (useNavigate, Link)." }
    ],
    "no-restricted-properties": [
      "error",
      {
        "object": "window",
        "property": "location",
        "message": "Naviga solo con React Router (useNavigate, Link)."
      },
      {
        "object": "document",
        "property": "location",
        "message": "Naviga solo con React Router (useNavigate, Link)."
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**/*.tsx"],
      "rules": { "no-inline-comments": "error" }
    },
    {
      "files": ["scripts/**", "tests/**", "*.config.*", "src/app/routes.ts"],
      "rules": { "no-restricted-globals": "off", "no-restricted-properties": "off" }
    }
  ]
}
